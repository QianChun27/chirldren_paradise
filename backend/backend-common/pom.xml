<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ backend-common：通用层（跨模块复用，无业务依赖）
  ~ 提供：统一响应体 Result<T>、业务异常体系、基类 DO、常量/枚举、JSON 类型处理器、Hutool 封装。
  ~ 本模块为「纯库」，不引入 Spring Boot 插件 repackage。
  -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paradise</groupId>
        <artifactId>backend-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>backend-common</artifactId>
    <packaging>jar</packaging>
    <name>paradise-backend-common</name>
    <description>通用层：Result/异常/基类/枚举/JSON 处理</description>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>
</project>
